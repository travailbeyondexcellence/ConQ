# ConQ Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ======================
# Core Service Configuration
# ======================
ENV=development
LOG_LEVEL=info

# ======================
# API Gateway Configuration
# ======================
PORT=8080

# ======================
# MongoDB Configuration
# ======================
# For Development (Docker):
MONGO_URI=mongodb://admin:password@localhost:27017

# For Production (MongoDB Atlas or your MongoDB instance):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

DB_NAME=conq

# ======================
# Redis Configuration
# ======================
REDIS_URI=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ======================
# NATS Message Broker
# ======================
NATS_URL=nats://localhost:4222

# ======================
# JWT Authentication
# ======================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=24h

# ======================
# MinIO (Object Storage)
# ======================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=conq-media

# ======================
# Email Service (Optional - for password reset, etc.)
# ======================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@conq.com

# ======================
# Service Ports (gRPC)
# ======================
AUTH_SERVICE_PORT=50051
USER_SERVICE_PORT=50052
CONTENT_SERVICE_PORT=50053
SCHEDULER_SERVICE_PORT=50054
PUBLISHER_SERVICE_PORT=50055
MEDIA_SERVICE_PORT=50056
APPROVAL_SERVICE_PORT=50057
ANALYTICS_SERVICE_PORT=50058
NOTIFICATION_SERVICE_PORT=50059

# ======================
# Platform Connector Ports
# ======================
FACEBOOK_CONNECTOR_PORT=50061
TWITTER_CONNECTOR_PORT=50062
INSTAGRAM_CONNECTOR_PORT=50063
LINKEDIN_CONNECTOR_PORT=50064
YOUTUBE_CONNECTOR_PORT=50065
TIKTOK_CONNECTOR_PORT=50066

# ======================
# Social Media API Keys (Add your actual keys)
# ======================
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
